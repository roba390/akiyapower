---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->
  <HeroText tagline="Contact" title="Let’s Connect!" />

  <ContactUs
    id="form"
    title="Drop us a message today!"
    subtitle="Got questions about courses, enrollment, or partnerships? We’re here to help."
    inputs={[
      { type: 'text', name: 'name', label: 'Name' },
      { type: 'email', name: 'email', label: 'Email' },
    ]}
    textarea={{ label: 'Message' }}
    disclaimer={{
      label:
        'By submitting this contact form, you acknowledge and agree to the collection of your personal information.',
    }}
    description="Our team typically responds within 24 business hours."
  />

  <!-- Features2 Widget ************** -->
  <Features2
    title="We are here to help!"
    items={[
      {
        title: 'Admissions & Enrollment',
        description:
          'Ask about course schedules, fees, registration, and entry requirements for our EV programs.',
        icon: 'tabler:school',
      },
      {
        title: 'Partnerships & Corporate Training',
        description:
          'Collaborate with us on custom training, workshops, or industry projects across Ethiopia.',
        icon: 'tabler:heart-handshake',
      },
      {
        title: 'Course & Curriculum Questions',
        description:
          'Battery Systems, Charging Infrastructure, Powertrain Diagnostics, EV Safety, Smart Systems, and more.',
        icon: 'tabler:charging-pile',
      },
      {
        title: 'Phone',
        description: '+251 900 00 58 09  |  +251 911 11 39 94',
        icon: 'tabler:phone',
      },
      {
        title: 'Email',
        description: 'contact@akiyapowertech.com',
        icon: 'tabler:mail',
      },
      {
        title: 'Location',
        description:
          'Meskel Flower, near Dreamline Hotel, inside Yami car sales compound, Addis Ababa, Ethiopia',
        icon: 'tabler:map-pin',
      },
    ]}
  />
</Layout>
