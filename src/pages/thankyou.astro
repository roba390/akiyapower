---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Button from '~/components/ui/Button.astro';

const metadata = {
  title: 'Thank You for Your Message',
  robots: {
    index: false, // Prevents search engines from indexing this page
    follow: false,
  },
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Submission Successful"
    title="Thank You!"
    subtitle="We have received your message and will get back to you within 24 business hours. We appreciate you contacting Akiya Power Tech."
  />

  <!-- Adds a button to guide the user back to the homepage -->
  <div class="text-center">
    <Button 
      href="/" 
      variant="primary" 
      text="Back to Homepage"
    />
  </div>
</Layout>