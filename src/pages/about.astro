---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';
import Content from '~/components/widgets/Content.astro';
import { Icon } from 'astro-icon/components';

// ✅ Custom Image component
import Image from '~/components/common/Image.astro';

// Images
import aboutImage from '~/assets/images/for-about-page.jpg';
import evWorkshopImage from '~/assets/images/students-working.jpg';
import theoryClassroomImage from '~/assets/images/theory-classroom.jpg';
import studentCertificateImage1 from '~/assets/images/students-certificates.jpg';
import studentCertificateImage2 from '~/assets/images/FIKR6984.jpg';
import studentCertificateImage3 from '~/assets/images/students-certificates.jpg';

const metadata = {
  title: 'About Akiya Power Tech',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="About Akiya Power Tech"
    image={{
      src: aboutImage,
      alt: 'Inside our EV training center',
      component: Image,
    }}
  >
    <Fragment slot="title">
      Empowering Africa’s EV Future <br />
      <span class="text-accent dark:text-white">Through Practical Technical Training</span>
    </Fragment>

    <Fragment slot="subtitle">
      Akiya Power Tech Training Center is Ethiopia’s emerging leader in electric vehicle training. We prepare technicians,
      students, and professionals for the future of transport with hands-on skills, modern labs, and industry-aligned
      curriculum.
    </Fragment>
  </Hero>

  <Stats
    title="Our Journey in Numbers"
    stats={[
      { title: 'Established', amount: '2020' },
      { title: 'Certified Courses', amount: '10' },
      { title: 'Students Trained', amount: '320+' },
      { title: 'EV Workshops', amount: '6' },
    ]}
  />

  <!-- Video Section -->
  <section class="py-12 md:py-20 bg-gray-50 dark:bg-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10 md:mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white">See Our Center in Action</h2>
        <p class="mt-4 text-lg text-gray-600 dark:text-slate-400">
          Get a glimpse of our state-of-the-art facility and the hands-on training that sets our students up for success.
        </p>
      </div>
      <div class="w-full rounded-lg overflow-hidden shadow-2xl" style="max-width: 100%; height: 400px; margin: auto;">
        <video
          class="w-full h-full object-contain"
          src="/videos/akiyapower-promo.mp4"
          controls
          poster={evWorkshopImage.src}
          style="width: 100%; height: 100%;"
          preload="none"
        >
          Your browser does not support the video tag.
        </video>
      </div>
    </div>
  </section>

  <Features3
    title="What We Teach"
    subtitle="We provide in-depth, practical training for electric vehicle technicians. Our programs are designed to match global standards while focusing on local relevance."
    columns={3}
    isBeforeContent={true}
    items={[
      {
        title: 'Battery Systems',
        description: 'Learn battery diagnostics, safety protocols, and energy storage fundamentals.',
        icon: 'tabler:battery-automotive',
      },
      {
        title: 'Charging Infrastructure',
        description: 'Understand EV charging stations, installation processes, and maintenance.',
        icon: 'tabler:charging-pile',
      },
      {
        title: 'Powertrain Diagnostics',
        description: 'Hands-on training in motor systems, controllers, and fault detection.',
        icon: 'tabler:settings',
      },
    ]}
  />

  <Features3
    columns={3}
    isAfterContent={true}
    items={[
      {
        title: 'EV Safety',
        description: 'Protocols, insulation handling, and emergency procedures tailored to Ethiopian standards.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Green Mobility',
        description: 'Sustainability training and eco-conscious practices for future technicians.',
        icon: 'tabler:leaf',
      },
      {
        title: 'Smart Systems',
        description: 'Intro to IoT integration in modern EVs and connected infrastructure.',
        icon: 'tabler:cpu',
      },
    ]}
    image={{
      src: evWorkshopImage,
      alt: 'Students working on an EV powertrain',
      component: Image,
      class: 'w-full h-full object-cover',
    }}
  />

  <Content
    isReversed={true}
    items={[
      {
        title: 'Theory Meets Practice',
        description:
          'Our curriculum begins in modern classrooms where students learn the foundational principles of EV technology. We cover everything from electrical theory to advanced diagnostics using interactive learning aids.',
      },
      {
        title: 'State-of-the-Art Workshops',
        description:
          'True expertise is built with your hands. Our workshops are fully equipped with the latest tools, diagnostic equipment, and electric vehicles, allowing students to apply theoretical knowledge to real-world mechanical and electrical challenges.',
      },
    ]}
    image={{
      src: theoryClassroomImage,
      alt: 'Akiya Power Tech theory classroom with students',
      component: Image,
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight sm:text-3xl mb-2">Our Learning Environment</h3>
      <p class="text-xl text-muted dark:text-slate-400">We foster a balanced learning approach.</p>
    </Fragment>
  </Content>

  <Steps2
    title="Our Core Values"
    subtitle="Our philosophy at Akiya Power Tech goes beyond machines. We believe in empowering human potential."
    items={[
      {
        title: 'Hands-On Learning',
        description: 'Our training is built around practical workshops and real-world scenarios—no boring lectures.',
      },
      {
        title: 'Local Relevance',
        description: 'We build courses that address local EV challenges and infrastructure needs.',
      },
      {
        title: 'Global Standards',
        description:
          'We align with international certifications, preparing trainees for opportunities across Africa and beyond.',
      },
    ]}
  />

  <Steps2
    title="Our Achievements"
    subtitle="In just a short time, Akiya Power Tech has made strides in awareness, engagement, and impact."
    isReversed={true}
    items={[
      {
        title: 'National TV Features',
        description: 'Our team has been featured on local media for leading EV education in Ethiopia.',
        icon: 'tabler:device-tv',
      },
      {
        title: 'Student Success Stories',
        description: 'Graduates have joined EV workshops, mobile service units, and renewable startups.',
        icon: 'tabler:user-star',
      },
      {
        title: 'Industry Partnerships',
        description: 'We’ve connected with suppliers and importers to align training with market demands.',
        icon: 'tabler:briefcase',
      },
    ]}
  />

  <!-- Graduates Section -->
  <section class="py-12 md:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10 md:mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white">Celebrating Our Graduates</h2>
        <p class="mt-4 text-lg text-gray-600 dark:text-slate-400">
          We are proud of our trainees who are now shaping the future of mobility in Ethiopia.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="text-center">
          <Image class="rounded-lg shadow-lg mx-auto mb-4 w-full h-auto object-cover aspect-[4/3]" src={studentCertificateImage1} alt="Graduate with certificate" />
          <p class="font-medium text-gray-800 dark:text-slate-300">Certified EV Technician</p>
        </div>
        <div class="text-center">
          <Image class="rounded-lg shadow-lg mx-auto mb-4 w-full h-auto object-cover aspect-[4/3]" src={studentCertificateImage2} alt="Students proudly display their certificates" />
          <p class="font-medium text-gray-800 dark:text-slate-300">Certified EV Technician</p>
        </div>
        <div class="text-center">
          <Image class="rounded-lg shadow-lg mx-auto mb-4 w-full h-auto object-cover aspect-[4/3]" src={studentCertificateImage3} alt="A successful trainee with their completion certificate" />
          <p class="font-medium text-gray-800 dark:text-slate-300">Certified EV Technician</p>
        </div>
      </div>
    </div>
  </section>

  <Features2
    title="Where We Are"
    tagline="Visit our training center"
    columns={2}
    items={[
      {
        title: 'Addis Ababa, Ethiopia',
        description: 'Gorgoreos square, Behind Kas tower Wengelawit ',
      },
      {
        title: 'Coming soon: Hawassa, Adama',
        description: 'Expansion planned in Most parts of Ethiopia by 2026',
      },
    ]}
  />

  <!-- Map -->
  <div class="py-12 px-4 md:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl font-bold tracking-tight text-center sm:text-4xl mb-8">Find Us on the Map</h2>
      <div class="aspect-w-16 aspect-h-9 w-full rounded-lg overflow-hidden shadow-lg">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d252226.19310211248!2d38.61423494133354!3d8.968989596554435!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x164b850048ff654d%3A0x91b64553a496f360!2sAkiya%20Power%20Tech%20Training%20Center!5e0!3m2!1sen!2set!4v1755783190816!5m2!1sen!2set"
          width="100%"
          height="350"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </div>

  <Features2
    title="Get in Touch"
    tagline="Ask about courses or partnerships"
    columns={2}
    items={[
      {
        title: 'Email',
        description: 'contact@akiyapowertech.com',
        icon: 'tabler:mail',
      },
      {
        title: 'Phone',
        description: '+251 900 00 58 09 || +251 911 11 39 94',
        icon: 'tabler:phone',
      },
    ]}
  />
</Layout>
