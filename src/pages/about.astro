---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';
import Content from '~/components/widgets/Content.astro';
import { Icon } from 'astro-icon/components';

import Image from '~/components/common/Image.astro';

// All your original images are kept
import aboutImage from '~/assets/images/EV-Hero.jpg';
import evWorkshopImage from '~/assets/images/students-working.jpg';
import theoryClassroomImage from '~/assets/images/theory-classroom.jpg';
import studentCertificateImage1 from '~/assets/images/students-certificates.jpg';
import studentCertificateImage2 from '~/assets/images/FIKR6984.jpg';
import studentCertificateImage3 from '~/assets/images/students-certificates.jpg';

const metadata = {
  title: 'About Akiya Power Tech',
};
---

<Layout metadata={metadata}>
  <!-- Hero Section: Text updated to include both business pillars -->
  <Hero
    tagline="About Akiya Power Tech"
    image={{ src: aboutImage, alt: 'Inside our EV training and service center' }}
  >
    <Fragment slot="title">
      Ethiopia’s Complete EV Solution <br />
      <span class="text-accent dark:text-white">Training Experts & Servicing Vehicles</span>
    </Fragment>

    <Fragment slot="subtitle">
      Akiya Power Tech is a unified center of excellence, leading the future of transport with hands-on technical training and professional, state-of-the-art vehicle servicing.
    </Fragment>
  </Hero>

  <!-- Stats Section: Updated to include service numbers -->
  <Stats
    title="Our Journey in Numbers"
    stats={[
      { title: 'Vehicles Serviced', amount: '500+' },
      { title: 'Students Trained', amount: '320+' },
      { title: 'Certified Courses', amount: '8+' },
      { title: 'Industry Partners', amount: '15+' },
    ]}
  />

  <!-- Video Section: Text updated slightly -->
  <section class="py-12 md:py-20 bg-gray-50 dark:bg-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10 md:mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white">See Our Center in Action</h2>
        <p class="mt-4 text-lg text-gray-600 dark:text-slate-400">
          Get a glimpse of our state-of-the-art facility where expert training and professional service come together.
        </p>
      </div>
      <div class="w-full rounded-lg overflow-hidden shadow-2xl" style="max-width: 100%; height: 400px; margin: auto;">
        <video class="w-full h-full object-contain" src="/videos/akiyapower-promo.mp4" controls poster={evWorkshopImage.src} style="width: 100%; height: 100%;" preload="none">
          Your browser does not support the video tag.
        </video>
      </div>
    </div>
  </section>

  <!-- NEW SECTION HEADER: To introduce both pillars -->
  <section class="py-16 lg:py-20">
    <div class="max-w-xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white">Our Two Pillars of Expertise</h2>
        <p class="mt-4 text-lg text-gray-600 dark:text-slate-400">We've built a complete ecosystem to support the entire lifecycle of electric vehicles in Ethiopia.</p>
    </div>
  </section>

  <!-- Content Section for Training: Repurposed from your original -->
  <Content
    isReversed={true}
    items={[
      {
        title: 'Theory Meets Practice',
        description: 'Our curriculum begins in modern classrooms where students learn the foundational principles of EV technology, from electrical theory to advanced diagnostics.',
      },
      {
        title: 'State-of-the-Art Workshops',
        description: 'Our workshops are fully equipped with the latest tools, allowing students to apply theoretical knowledge to real-world mechanical and electrical challenges.',
      },
    ]}
    image={{ src: theoryClassroomImage, alt: 'Akiya Power Tech theory classroom' }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight sm:text-3xl mb-2">Pillar 1: The Training Center</h3>
      <p class="text-xl text-muted dark:text-slate-400">We create the next generation of certified EV technicians.</p>
    </Fragment>
  </Content>
  
  <!-- NEW Content Section for Servicing: Using your existing components -->
  <Content
    items={[
      {
        title: 'Advanced Diagnostics',
        description: 'We use manufacturer-grade tools to accurately identify issues, from battery health to software glitches, ensuring a precise and effective repair.',
      },
      {
        title: 'Professional Maintenance & Repair',
        description: 'Our certified technicians provide a full range of services, including battery conditioning, brake servicing, and motor repair, to keep your EV in peak condition.',
      },
    ]}
    image={{ src: evWorkshopImage, alt: 'An expert technician servicing an electric vehicle' }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight sm:text-3xl mb-2">Pillar 2: The Service Center</h3>
      <p class="text-xl text-muted dark:text-slate-400">We provide trusted, expert care for EV owners.</p>
    </Fragment>
  </Content>

  <!-- Your original Steps2, Features3, Graduates, and Map sections are below, with minor text tweaks -->

  <Steps2
    title="Our Core Values"
    subtitle="Our philosophy at Akiya Power Tech applies to everything we do, from training students to servicing vehicles."
    items={[
      { title: 'Hands-On Expertise', description: 'We believe in practical, real-world application, whether in a training lab or a service bay.' },
      { title: 'Local Relevance', description: 'We address local EV challenges and infrastructure needs for both technicians and drivers.' },
      { title: 'Global Standards', description: 'We align with international best practices for both training and vehicle repair.' },
    ]}
  />

  <Steps2
    title="Our Achievements"
    subtitle="In just a short time, Akiya Power Tech has made strides in awareness, engagement, and impact."
    isReversed={true}
    items={[
      { title: 'National TV Features', description: 'Featured on local media for leading EV education and service in Ethiopia.' },
      { title: 'Student Success Stories', description: 'Our graduates have joined top EV workshops, mobile service units, and renewable startups.' },
      { title: 'Industry Partnerships', description: 'We connect with suppliers and importers to align training and service with market demands.' },
    ]}
  />

  <section class="py-12 md:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10 md:mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white">Celebrating Our Graduates</h2>
        <p class="mt-4 text-lg text-gray-600 dark:text-slate-400">We are proud of our trainees who are now shaping the future of mobility in Ethiopia.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="text-center">
          <Image class="rounded-lg shadow-lg mx-auto mb-4 w-full h-auto object-cover aspect-[4/3]" src={studentCertificateImage1} alt="Graduate with certificate" />
        </div>
        <div class="text-center">
          <Image class="rounded-lg shadow-lg mx-auto mb-4 w-full h-auto object-cover aspect-[4/3]" src={studentCertificateImage2} alt="Students proudly display their certificates" />
        </div>
        <div class="text-center">
          <Image class="rounded-lg shadow-lg mx-auto mb-4 w-full h-auto object-cover aspect-[4/3]" src={studentCertificateImage3} alt="A successful trainee with their completion certificate" />
        </div>
      </div>
    </div>
  </section>
  
  <div class="py-12 px-4 md:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl font-bold tracking-tight text-center sm:text-4xl mb-8">Find Us on the Map</h2>
      <div class="aspect-w-16 aspect-h-9 w-full rounded-lg overflow-hidden shadow-lg">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d252226.19310211248!2d38.61423494133354!3d8.968989596554435!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x164b850048ff654d%3A0x91b64553a496f360!2sAkiya%20Power%20Tech%20Training%20Center!5e0!3m2!1sen!2set!4v1755783190816!5m2!1sen!2set" width="100%" height="350" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </div>

  <Features2
    title="Get in Touch"
    tagline="Ask about courses, servicing, or partnerships"
    columns={2}
    items={[
      { title: 'Email', description: 'contact@akiyapowertech.com', icon: 'tabler:mail' },
      { title: 'Phone', description: '+251 900 00 58 09 || +251 911 11 39 94', icon: 'tabler:phone' },
    ]}
  />
</Layout>