---
import Layout from '~/layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import Button from '~/components/ui/Button.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

// Using the same image for the new custom hero section.
import pageHeaderImage from '~/assets/images/standing.webp';

const metadata = {
  title: 'Admissions & Enrollment | Akiya Power Tech',
  description: 'Begin your journey to becoming a certified EV technician with Akiya Power Tech. Learn about our programs and how to enroll.',
};
---

<Layout metadata={metadata}>
  <!-- 
    CUSTOM HERO SECTION:
    - This is the new hero, styled exactly like the one on the about.astro page.
    - It is shorter, has a static background image, and is fully responsive.
  -->
  <section class="relative text-white">
    <div class="relative h-[50vh] min-h-[400px] overflow-hidden flex flex-col justify-center items-center text-center px-4">
      
      <!-- Background Image Layer -->
      <div class="absolute inset-0 z-0">
        <Image
          src={pageHeaderImage}
          alt="A student working on an EV at Akiya Power Tech"
          class="w-full h-full object-cover"
          format="webp"
          quality={80}
          loading="eager"
        />
        <!-- Dark Overlay -->
        <div class="absolute inset-0 bg-black/50"></div>
      </div>

      <!-- Content Layer -->
      <div class="relative z-10">
        <h1 class="text-4xl md:text-5xl font-bold leading-tight">
          Admissions & <span class="text-yellow-400">Enrollment</span>
        </h1>
        <p class="hidden md:block mt-4 text-lg text-gray-200 max-w-3xl">
          Start your career as a certified Electric Vehicle technician in Addis Ababa. Here you'll find everything you need to know about our programs and how to begin your journey with Akiya Power Tech.
        </p>
      </div>
    </div>
  </section>

  <!-- The rest of your page content, now on a slightly different background for visual separation -->
  <section class="bg-slate-50 dark:bg-slate-800/50">

    <!-- Your existing, well-structured content components fit perfectly here. -->
    <Features
      id="program-overview"
      tagline="Our Training Philosophy"
      title="Become a Leader in the Future of Transportation"
      items={[
        { title: 'Program Objective', description: 'Our certification program is designed to equip trainees with the essential skills and knowledge required to maintain and service electric vehicles (EVs).', icon: 'tabler:target-arrow' },
        { title: 'Hands-On Curriculum', description: 'The training focuses on both theoretical and practical aspects of EV maintenance, from understanding core components to mastering diagnostic tools.', icon: 'tabler:book' },
        { title: 'Career Outcomes', description: 'Upon completion, you will be prepared for certification in EV maintenance, making you a valuable asset in the evolving automotive industry.', icon: 'tabler:certificate' },
        { title: 'State-of-the-Art Facilities', description: 'Train in our modern workshop in Addis Ababa, featuring the latest EV models and diagnostic equipment to provide a realistic learning environment.', icon: 'tabler:building-factory' },
      ]}
    />

    <Features2
      title="Choose Your Training Path"
      subtitle="We offer specialized EV training programs designed to fit your needs and schedule."
      items={[
        { title: 'Two-Month Comprehensive Program', description: 'An in-depth program covering all aspects of Electric Vehicle (EV) Maintenance and Servicing.', icon: 'tabler:calendar-month' },
        { title: 'Intensive 15-Day Program', description: 'A focused, fast-tracked training on Electric Vehicle (EV) Maintenance and Servicing for professionals.', icon: 'tabler:calendar-event' },
        { title: 'Customized Training', description: 'We create custom training programs to meet the specific needs of your organization or team. Contact us to learn more.', icon: 'tabler:school' },
      ]}
    />

    <Steps
      title="Your Path to Enrollment"
      subtitle="Follow these simple steps to begin your journey with Akiya Power Tech."
      items={[
        { title: 'Step 1: Choose Your Program', description: 'Review the comprehensive and intensive training programs and decide which path is the right fit for your career goals.', icon: 'tabler:list-check' },
        { title: 'Step 2: Contact Our Admissions Team', description: 'Reach out to us via our contact form or by phone. Our team is ready to answer your questions.', icon: 'tabler:phone-call' },
        { title: 'Step 3: Complete Your Enrollment', description: 'Our admissions team will guide you through the final registration and payment process to secure your spot.', icon: 'tabler:file-check' },
        { title: 'Step 4: Begin Your Training!', description: 'Join our expert instructors at our state-of-the-art facility in Addis Ababa and start your journey.', icon: 'tabler:player-play' },
      ]}
    />

    <CallToAction
      actions={[
        { variant: 'primary', text: 'Contact Admissions', href: '/contact', icon: 'tabler:mail-forward' },
      ]}
    >
      <Fragment slot="title">Ready to Power Up Your Career?</Fragment>
      <Fragment slot="subtitle">
        Take the first step towards a successful career in the EV industry. <br class="hidden md:inline" />Contact our admissions team today to get started.
      </Fragment>
    </CallToAction>
    
  </section>
</Layout>