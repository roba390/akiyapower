---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import TestimonialSlider from '~/components/TestimonialSlider.astro';
import repair from '~/assets/images/repair.jpg';
import technician from '~/assets/images/About-page.jpg';
import newbyd from '~/assets/images/new3.webp';
import webmVideo from '~/assets/images/Byd-video.webm'; // If you created one
import posterImage from '~/assets/images/Byd-poster.webp';
const metadata = {
  title: 'Akiya Power Tech | EV Training and Service Center',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
 <!-- Hero Widget ******************* -->
    <Hero
    // 👇 2. USE THE NEW VIDEO AND POSTER PROPS
    poster={{ src: posterImage, alt: 'Akiya Power Tech workshop background' }}
    video={[
      { src: webmVideo, type: 'video/webm' }, // Browser will try this first
      // { src: mp4Video, type: 'video/mp4' }   // Fallback for Safari, etc.
    ]}
    actions={[ /* ... your actions ... */ ]}
  >
    <Fragment slot="title">
      <span class="text-yellow-400">Akiya Power Tech</span> training and service center
    </Fragment>

    <Fragment slot="subtitle">
      <p class="hidden md:block text-lg text-gray-200 mb-8 [text-wrap:balance]">
        The leading center for hands-on EV training and professional repair services in Addis Ababa.
      </p>
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->
  <Note title="Our Mission:" description="To empower technicians and consumers in Addis Ababa with the knowledge and skills to accelerate the transition to electric mobility." />

  <!-- Features Widget *************** -->
  <Features
    id="features"
    tagline="Why Choose Us"
    title="What you get with Akiya Power Tech"
    subtitle="We provide Ethiopia's most comprehensive and hands-on EV training and servicing, ensuring you are at the forefront of automotive technology."
    items={[
      {
        title: 'Expert-Led EV Training',
        description: 'Our curriculum is designed and taught by industry veterans with years of experience in electric vehicle technology.',
        icon: 'tabler:users',
      },
      {
        title: 'Professional EV Service',
        description: 'Our state-of-the-art workshop provides real-world experience in diagnosing and fixing all makes of EVs.',
        icon: 'tabler:tool',
      },
      {
        title: 'Industry-Recognized Certification',
        description: 'Graduate with a certification that is respected and recognized by leading EV manufacturers and service centers.',
        icon: 'tabler:certificate',
      },
      {
        title: 'State-of-the-Art Diagnostic Tools',
        description: 'We utilize the latest in diagnostic equipment to accurately identify and resolve any issue with your electric vehicle.',
        icon: 'tabler:search',
      },
      {
        title: 'Comprehensive Curriculum',
        description: "From battery technology to ADAS, our courses cover every aspect of modern EVs.",
        icon: 'tabler:book',
      },
      {
        title: 'Dedicated Career Support',
        description: 'We are committed to your success and helping you launch or advance your career in the EV industry.',
        icon: 'tabler:briefcase',
      },
    ]}
  />

  <!-- Content Widget for TRAINING **************** -->
  <Content
    isReversed
    tagline="Our Training Programs"
    title="Built for the Future of Automotive"
    items={[
      {
        title: 'Beginner to Advanced Courses',
        description: 'No matter your skill level, we have a training path designed to make you a proficient EV technician.',
      },
      {
        title: 'Focus on Practical Skills',
        description: 'Our training emphasizes hands-on learning to ensure you are prepared for real-world challenges.',
      },
      {
        title: 'Safety First Approach',
        description: 'Learn the proper safety protocols for handling high-voltage systems, ensuring a safe working environment.',
      },
    ]}
    image={{
      src: technician,
      alt: 'Akiya Power Tech Training Session',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Empowering the Next Generation of Technicians</h3>
      Gain a competitive edge with our industry-leading training programs.
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget for SERVICES **************** -->
  <Content
    tagline="EV Service Center"
    title="Expert Care for Your Electric Vehicle"
    items={[
      {
        title: 'Comprehensive Diagnostics',
        description: `We use the latest tools and software to accurately diagnose and repair your EV, saving you time and money.`,
      },
      {
        title: 'Battery Health Services',
        description: 'Our experts can assess the health of your EV battery and provide solutions to optimize its performance and longevity.',
      },
      {
        title: 'Routine Maintenance and Repairs',
        description: "From software updates to brake service, we provide a full range of maintenance to keep your EV running smoothly.",
      },
    ]}
    image={{
      src: repair,
      alt: 'Akiya Power Tech Service Center',
    }}
  >
    <Fragment slot="content">Your trusted partner for EV service and repair in Addis Ababa.</Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->
  <Steps
    isReversed
    title="Start Your EV Technician Career in 3 Simple Steps"
    items={[
      {
        title: 'Step 1: <span class="font-medium">Explore Our Courses</span>',
        description: "Take a look at our range of training programs and find the one that's right for you.",
        icon: 'tabler:list-search',
      },
      {
        title: 'Step 2: <span class="font-medium">Enroll and Learn</span>',
        description: "Sign up for your chosen course and begin your journey to becoming an EV expert with our hands-on training.",
        icon: 'tabler:school',
      },
      {
        title: 'Step 3: <span class="font-medium">Get Certified</span>',
        description: 'Receive an industry-recognized certification that will open doors to new career opportunities in the EV industry.',
        icon: 'tabler:certificate',
      },
    ]}
    image={{
      src: newbyd,
      alt: 'Steps image',
    }}
    
  />

  <!-- FAQs Widget ******************* -->
  <FAQs
    title="Frequently Asked Questions"
    subtitle="Find answers to common questions about our EV training and service offerings."
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'Why should I choose a career as an EV technician?',
        description: "The demand for skilled EV technicians is rapidly growing. A career in this field offers job security and the opportunity to work with cutting-edge technology.",
      },
      {
        title: 'How do I book a service appointment for my EV?',
        description: "You can book an appointment by clicking the 'Book a Service' button, which will take you to our online booking application. You can also call us directly.",
      },
      {
        title: 'What do I need to enroll in your courses?',
        description: 'Our courses are designed for individuals with a passion for automotive technology. Please contact us for specific course prerequisites.',
      },
      {
        title: "What types of EVs do you service?",
        description: "Our certified technicians have the expertise to service a wide range of electric vehicle makes and models available in Ethiopia.",
      },
    ]}
  />

  <!-- Testimonials Widget *********** -->
  <!-- FIXED: Removed the gray background container -->
  <section id="testimonials" class="py-16 lg:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="mb-12 text-center">
        <p class="text-base font-semibold uppercase tracking-wider text-accent dark:text-blue-400">
          Testimonials
        </p>
        <h2 class="font-heading mb-4 font-bold tracking-tight text-gray-900 dark:text-white text-3xl sm:text-4xl">
          What Our Students & Partners Say
        </h2>
        <p class="mt-4 text-xl text-gray-600 dark:text-slate-400">
          Hear from technicians who have advanced their careers with Akiya Power Tech.
        </p>
      </div>
      <TestimonialSlider />
    </div>
  </section>

  <!-- Stats Widget ****************** -->
  <Stats
    stats={[
      { title: 'Students Trained', amount: '320+' },
      { title: 'Vehicles Serviced', amount: '500+' },
      { title: 'Industry Partners', amount: '15+' },
      { title: 'Certified Technicians', amount: '10+' },
    ]}
  />

  <!-- CallToAction Widget *********** -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Enroll Now',
        href: '/contact',
        icon: 'tabler:school',
      },
      // ADDED: A second button for the service center
      {
        variant: 'secondary',
        text: 'Book a Service',
        href: 'https://my-booking-app-ecru.vercel.app/', // Links to booking app
        icon: 'tabler:calendar-event',
        'data-confirm-external': true,
        'data-confirm-message': 'You are headed to our secure booking portal. Continue?',
      }
    ]}
  >
    <Fragment slot="title">
      Ready to Power Up Your Future?
    </Fragment>
    <Fragment slot="subtitle">
      Join the electric revolution with Akiya Power Tech. <br class="hidden md:inline" />Enroll in our courses or book an expert service for your EV today!
    </Fragment>
  </CallToAction>
</Layout>