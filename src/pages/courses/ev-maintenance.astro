---
import PageLayout from '~/layouts/PageLayout.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Image } from 'astro:assets';

// Your image imports are perfect
import evImage from '~/assets/images/for-class.jpg';
import benefitImage from '~/assets/images/for-courses.jpg';

const metadata = {
  title: 'Intro to EV and Safety | Akiya Power Tech',
};
---

<PageLayout metadata={metadata}>
  <!-- 
    CUSTOM HERO SECTION:
    - This is the new hero, styled consistently with your other internal pages.
  -->
  <section class="relative text-white">
    <div class="relative h-[50vh] min-h-[400px] overflow-hidden flex flex-col justify-center items-center text-center px-4">
      
      <!-- Background Image Layer -->
      <div class="absolute inset-0 z-0">
        <Image
          src={evImage}
          alt="Technician learning EV safety protocols"
          class="w-full h-full object-cover"
          format="webp"
          quality={80}
          loading="eager"
        />
        <!-- Dark Overlay -->
        <div class="absolute inset-0 bg-black/50"></div>
      </div>

      <!-- Content Layer -->
      <div class="relative z-10">
        <p class="text-sm font-semibold uppercase text-gray-300">
          Foundational Course
        </p>
        <h1 class="mt-2 text-4xl md:text-5xl font-bold leading-tight">
          Intro to EV and <span class="text-blue-400">Safety</span>
        </h1>
        <p class="hidden md:block mt-4 text-lg text-gray-200 max-w-3xl">
          This course introduces electric vehicle systems and the critical safety procedures required when working with high-voltage components.
        </p>
      </div>
    </div>
  </section>
  
  <!-- 
    YOUR EXISTING CONTENT SECTIONS:
    - This content is well-structured and is preserved.
  -->
  <Content
    tagline="Course Overview"
    title="What You'll Learn"
    isReversed
    items={[
      { title: 'EV Architecture Basics', description: 'Explore the evolution of electric vehicles and their core systems.' },
      { title: 'Safety Standards & PPE', description: 'Learn industry-standard safety protocols and personal protective equipment usage.' },
      { title: 'High-Voltage Awareness', description: 'Understand the risks and handling procedures for high-voltage EV systems.' },
      // { title: 'Emergency Response', description: 'Prepare for fault scenarios and apply safe shutdown techniques.' },
    ]}
    image={{ src: evImage, alt: 'EV safety training in progress' }}
  >
    <span slot="content">
      <p class="text-lg">This course is ideal for beginners, technicians, and anyone entering the EV service field. It lays the groundwork for advanced EV diagnostics and maintenance training.</p>
    </span>
  </Content>

  <Content
    tagline="Why Take This Course"
    title="Key Benefits"
    items={[
      { title: 'Industry-Relevant Curriculum', description: 'Content aligned with global EV safety standards and best practices.' },
      { title: 'Hands-On Demonstrations', description: 'Experience real-world safety scenarios and equipment handling.' },
      { title: 'Foundation for Certification', description: 'Build the knowledge base required for future EV technician certification.' },
      // { title: 'Flexible Learning', description: 'Designed to accommodate both full-time students and working professionals.' },
    ]}
    image={{ src: benefitImage, alt: 'EV safety gear and training tools' }}
  >
    <span slot="content">
      <p class="text-lg">Safety is the cornerstone of EV service. This course ensures you start your journey with the right mindset and tools to protect yourself and others.</p>
    </span>
    <span slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </span>
  </Content>

  <!-- 
    UPGRADED CALL TO ACTION:
    - Replaces the simple div with the standard <CallToAction> widget for consistency.
  -->
  <CallToAction
    actions={[
      { variant: 'primary', text: 'Contact Us to Enroll', href: '/contact', icon: 'tabler:mail-forward' },
    ]}
  >
    <Fragment slot="title">Ready to Start Your EV Journey Safely?</Fragment>
    <Fragment slot="subtitle">
      Reach out to learn more about course schedules and enrollment options for this essential foundational course.
    </Fragment>
  </CallToAction>
</PageLayout>