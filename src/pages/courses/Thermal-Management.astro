---
import PageLayout from '~/layouts/PageLayout.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Image } from 'astro:assets';

// Your image imports are perfect
import thermalImage from '~/assets/images/ev-core.jpg';
import benefitImage from '~/assets/images/for-courses.jpg';

const metadata = {
  title: 'EV Thermal Management Training | Akiya Power Tech',
};
---

<PageLayout metadata={metadata}>
  <!-- 
    CUSTOM HERO SECTION:
    - This is the new hero, styled consistently with your other internal pages.
  -->
  <section class="relative text-white">
    <div class="relative h-[50vh] min-h-[400px] overflow-hidden flex flex-col justify-center items-center text-center px-4">
      
      <!-- Background Image Layer -->
      <div class="absolute inset-0 z-0">
        <Image
          src={thermalImage}
          alt="EV thermal system training"
          class="w-full h-full object-cover"
          format="webp"
          quality={80}
          loading="eager"
        />
        <!-- Dark Overlay -->
        <div class="absolute inset-0 bg-black/50"></div>
      </div>

      <!-- Content Layer -->
      <div class="relative z-10">
        <p class="text-sm font-semibold uppercase text-gray-300">
          Advanced Course
        </p>
        <h1 class="mt-2 text-4xl md:text-5xl font-bold leading-tight">
          Electric Thermal <span class="text-blue-400">Management</span>
        </h1>
        <p class="hidden md:block mt-4 text-lg text-gray-200 max-w-3xl">
          Learn how electric vehicles manage heat across critical components to ensure safety, performance, and energy efficiency.
        </p>
      </div>
    </div>
  </section>
  
  <!-- 
    YOUR EXISTING CONTENT SECTIONS:
    - This content is well-structured and is preserved.
  -->
  <Content
    tagline="Course Overview"
    title="What You'll Learn"
    isReversed
    items={[
      { title: 'Thermal System Architecture', description: 'Understand the layout and function of cooling loops, heat exchangers, and HVAC systems in EVs.' },
      { title: 'Battery Cooling & Heating', description: 'Explore techniques for maintaining optimal battery temperature during charging and discharging.' },
      { title: 'Cabin Climate Control', description: 'Learn how electric HVAC systems operate efficiently without traditional combustion heat sources.' },
      // { title: 'Diagnostics & Maintenance', description: 'Use tools to inspect thermal systems, detect leaks, and ensure proper fluid circulation.' },
    ]}
    image={{ src: thermalImage, alt: 'EV thermal components and sensors' }}
  >
    <span slot="content">
      <p class="text-lg">This course is designed for EV technicians, engineers, and service professionals who want to master the thermal dynamics of electric vehicles.</p>
    </span>
  </Content>

  <Content
    tagline="Why Take This Course"
    title="Key Benefits"
    items={[
      { title: 'Hands-On Cooling System Labs', description: 'Work with real EV thermal systems, including battery chillers and heat pumps.' },
      { title: 'Energy Efficiency Insights', description: 'Learn how thermal management affects range, performance, and component longevity.' },
      { title: 'Safety Protocols', description: 'Understand how to safely service high-voltage thermal systems and handle refrigerants.' },
      // { title: 'Industry Relevance', description: 'Gain skills applicable to EV maintenance, design, and climate control engineering.' },
    ]}
    image={{ src: benefitImage, alt: 'EV thermal lab and technician tools' }}
  >
    <span slot="content">
      <p class="text-lg">Thermal management is critical to EV reliability. This course equips you with the knowledge to optimize and troubleshoot these systems effectively.</p>
    </span>
    <span slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </span>
  </Content>

  <!-- 
    UPGRADED CALL TO ACTION:
    - Replaces the simple div with the standard <CallToAction> widget for consistency.
  -->
  <CallToAction
    actions={[
      { variant: 'primary', text: 'Contact Us to Enroll', href: '/contact', icon: 'tabler:mail-forward' },
    ]}
  >
    <Fragment slot="title">Ready to Master EV Thermal Systems?</Fragment>
    <Fragment slot="subtitle">
      Ready to master the systems that keep EVs running cool and efficiently? Let’s get you started.
    </Fragment>
  </CallToAction>
</PageLayout>