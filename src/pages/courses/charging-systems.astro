---
import PageLayout from '~/layouts/PageLayout.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Image } from 'astro:assets';

// Your image imports are perfect
import chargingImage from '~/assets/images/charging-statiom.jpg';
import chargingBenefitImage from '~/assets/images/ev-charging.jpg';

const metadata = {
  title: 'Charging Systems Training | Akiya Power Tech',
};
---

<PageLayout metadata={metadata}>
  <!-- 
    CUSTOM HERO SECTION:
    - This is the new hero, styled consistently with your other internal pages.
  -->
  <section class="relative text-white">
    <div class="relative h-[50vh] min-h-[400px] overflow-hidden flex flex-col justify-center items-center text-center px-4">
      
      <!-- Background Image Layer -->
      <div class="absolute inset-0 z-0">
        <Image
          src={chargingImage}
          alt="EV Charging Station Installation Training"
          class="w-full h-full object-cover"
          format="webp"
          quality={80}
          loading="eager"
        />
        <!-- Dark Overlay -->
        <div class="absolute inset-0 bg-black/50"></div>
      </div>

      <!-- Content Layer -->
      <div class="relative z-10">
        <p class="text-sm font-semibold uppercase text-gray-300">
          Specialization Course
        </p>
        <h1 class="mt-2 text-4xl md:text-5xl font-bold leading-tight">
          EV <span class="text-blue-400">Charging Systems</span>
        </h1>
        <p class="hidden md:block mt-4 text-lg text-gray-200 max-w-3xl">
          Learn to set up, maintain, and troubleshoot AC/DC charging systems for Ethiopia’s evolving EV grid.
        </p>
      </div>
    </div>
  </section>
  
  <!-- 
    YOUR EXISTING CONTENT SECTIONS:
    - This content is well-structured and is preserved.
  -->
  <Content
    tagline="Course Overview"
    title="What You'll Learn"
    isReversed
    items={[
      { title: 'Charger Types', description: 'Explore AC Level 1, Level 2, and DC fast charging systems—design, specs, and use cases.' },
      { title: 'Installation Procedures', description: 'Master safe setup, power routing, voltage requirements, and code compliance.' },
      { title: 'Diagnostics & Maintenance', description: 'Troubleshoot faults, connector issues, overheating, and firmware problems.' },
      // { title: 'Safety Protocols', description: 'Learn grounding, isolation, fire prevention standards, and emergency handling.' },
    ]}
    image={{ src: chargingImage, alt: 'Charging Setup Workshop' }}
  >
    <span slot="content">
      <p class="text-lg">This course is ideal for technicians, electricians, and engineers looking to specialize in EV charging infrastructure and service operations.</p>
    </span>
  </Content>

  <Content
    tagline="Why Take This Course"
    title="Key Benefits"
    items={[
      { title: 'Hands-On Charger Installs', description: 'Wire, configure, and test actual AC/DC units in simulated environments.' },
      { title: 'Grid-Aware Curriculum', description: 'Learn about load balancing, smart charging, and sustainable deployment.' },
      { title: 'Career-Ready Tools', description: 'Use commercial-grade installation and fault detection devices.' },
      // { title: 'Standard Compliance', description: 'Follow Ethiopian EV charging codes and international protocols.' },
    ]}
    image={{ src: chargingBenefitImage, alt: 'Trainees installing EV chargers' }}
  >
    <span slot="content">
      <p class="text-lg">Charging systems are the backbone of EV adoption. This course equips you to build, maintain, and optimize them for Ethiopia’s growing electric grid.</p>
    </span>
    <span slot="bg">
      <div class="absolute inset-0 bg-indigo-50 dark:bg-transparent"></div>
    </span>
  </Content>

  <!-- 
    UPGRADED CALL TO ACTION:
    - Replaces the simple div with the standard <CallToAction> widget for consistency.
  -->
  <CallToAction
    actions={[
      { variant: 'primary', text: 'Contact Us to Enroll', href: '/contact', icon: 'tabler:mail-forward' },
    ]}
  >
    <Fragment slot="title">Ready to Power the EV Infrastructure?</Fragment>
    <Fragment slot="subtitle">
      Only a few seats are left for the next session. Apply early to guarantee your admission and become an expert in EV charging systems.
    </Fragment>
  </CallToAction>
</PageLayout>