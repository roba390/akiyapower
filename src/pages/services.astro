---
import Layout from '~/layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import Button from '~/components/ui/Button.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import pageHeaderImage from '~/assets/images/Tech-For_Hero.jpg'; 

const metadata = {
  title: 'Our EV Services | Akiya Power Tech',
  description: 'Akiya Power Tech offers expert EV maintenance and repair services in Addis Ababa, from battery diagnostics to software updates.'
};
---

<Layout metadata={metadata}>
  <!-- 
    CORRECTED RESPONSIVE PAGE HEADER:
    - Now adapts correctly for mobile devices.
  -->
  <section class="bg-slate-50 dark:bg-slate-800/50 py-16 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center">
        
        <!-- Image Content (Now visible on mobile and ordered first) -->
        <div class="order-first md:order-none">
          <Image
            src={pageHeaderImage}
            alt="The Akiya Power Tech Service Center Workshop"
            class="rounded-lg shadow-lg"
            format="webp"
            quality={80}
            width={600}
            height={400}
          />
        </div>

        <!-- Text Content (Ordered last on mobile) -->
        <div class="text-center md:text-left order-last md:order-none">
          <p class="text-sm font-semibold uppercase text-blue-600 dark:text-blue-400">
            Akiya Power Tech Service Center
          </p>
          <h1 class="mt-2 text-4xl md:text-5xl font-bold tracking-tight text-gray-900 dark:text-white">
            Expert EV Maintenance & Repair
          </h1>
          <!-- Paragraph and Button are now hidden on mobile -->
          <p class="hidden md:block mt-6 text-lg text-gray-600 dark:text-gray-400">
            Your trusted partner for professional electric vehicle service in Addis Ababa. We use state-of-the-art tools to keep your EV running at its best.
          </p>
          <div class="hidden md:block mt-8">
            <Button 
              variant="primary" 
              text="Book an Appointment Now" 
              href="https://my-booking-app-ecru.vercel.app/" 
              icon="tabler:calendar-event"
              'data-confirm-external'={true}
              'data-confirm-message'="You are headed to our secure booking portal. Continue?"
            />
          </div>
        </div>
        
      </div>
    </div>
  </section>
  
  <!-- The rest of your page content remains unchanged -->
  <section class="bg-white dark:bg-slate-900">
    <Features2
      title="Our Core Services"
      subtitle="From routine maintenance to complex diagnostics, we handle all your EV needs with precision and care."
      columns={3}
      items={[ /* ... your service items ... */ ]}
    />
    <Steps
      title="Our Simple & Transparent Service Process"
      items={[ /* ... your step items ... */ ]}
      image={{
        src: 'https://images.unsplash.com/photo-1525909002-1b05e0c869d8?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=870&q=80',
        alt: 'A technician working on a car',
      }}
    />
    <CallToAction
      actions={[ /* ... your CTA actions ... */ ]}
      title="Ready to Schedule Your Service?"
      subtitle="Don't wait for a small issue to become a big problem. Book your appointment today and experience the Akiya Power Tech difference."
    />
  </section>
</Layout>