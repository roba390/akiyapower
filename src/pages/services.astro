---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro'; // Using Steps for a clearer process
import CallToAction from '~/components/widgets/CallToAction.astro';

// ADDED: Importing a relevant hero image
import heroBgImage from '~/assets/images/Tech-For_Hero.jpg'; 

const metadata = {
  title: 'Our EV Services',
  description: 'Akiya Power Tech offers expert EV maintenance and repair services in Addis Ababa, from battery diagnostics to software updates.'
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <Hero
    tagline="Akiya Power Tech Service Center"
    title="Expert EV Maintenance & Repair"
    subtitle="Your trusted partner for professional electric vehicle service in Addis Ababa. We use state-of-the-art tools to keep your EV running at its best."
    actions={[{ 
      variant: 'primary', 
      text: 'Book an Appointment Now', 
      href: 'https://your-booking-app-url.com', // IMPORTANT: Update this link
      icon: 'tabler:calendar-event'
    }]}
    image={{
      src: heroBgImage,
      alt: 'Akiya Power Tech Service Center Workshop',
    }}
  />

  <!-- Features2 Widget (Our Core Services) ************** -->
  <Features2
    title="Our Core Services"
    subtitle="From routine maintenance to complex diagnostics, we handle all your EV needs with precision and care."
    columns={3}
    items={[
      {
        title: 'Battery Health Diagnostics',
        description: 'We perform in-depth analysis of your EV’s battery pack to assess its health, performance, and expected longevity.',
        icon: 'tabler:battery-automotive',
      },
      {
        title: 'Electric Motor Servicing',
        description: 'Our technicians are trained to diagnose and service the core of your EV—the electric traction motor—ensuring optimal performance.',
        icon: 'tabler:engine',
      },
      {
        title: 'Brake System Maintenance',
        description: 'Specialized service for EV regenerative and hydraulic braking systems to ensure your safety and vehicle efficiency.',
        icon: 'tabler:disc',
      },
      {
        title: 'Software & Firmware Updates',
        description: 'Keep your vehicle up-to-date with the latest manufacturer software to improve performance, features, and safety.',
        icon: 'tabler:device-laptop',
      },
      {
        title: 'Charging Port & System Repair',
        description: 'Having trouble charging? We diagnose and repair issues with onboard chargers, charging ports, and related systems.',
        icon: 'tabler:plug',
      },
      {
        title: 'ADAS Calibration',
        description: 'Expert calibration for your Advanced Driver-Assistance Systems (ADAS) like cameras and sensors after repairs.',
        icon: 'tabler:steering-wheel',
      },
      {
        title: 'Thermal Management Service',
        description: 'We service the crucial coolant and thermal systems that protect your battery and powertrain from overheating.',
        icon: 'tabler:snowflake',
      },
      {
        title: 'Pre-Purchase Inspection',
        description: 'Considering a used EV? Let our experts perform a thorough inspection to give you peace of mind before you buy.',
        icon: 'tabler:search',
      },
      {
        title: 'General Maintenance',
        description: 'Covering everything from tire rotations and suspension checks to cabin air filter replacements for all EV models.',
        icon: 'tabler:settings-bolt',
      },
    ]}
  />

  <!-- Steps Widget (Our Service Process) **************** -->
  <Steps
    title="Our Simple & Transparent Service Process"
    items={[
      {
        title: 'Step 1: Book Your Appointment',
        description: 'Use our easy online booking system or give us a call to schedule a time that works for you.',
        icon: 'tabler:calendar-plus',
      },
      {
        title: 'Step 2: Expert Diagnosis',
        description: 'Our certified technicians use advanced diagnostic tools to accurately identify the issue with your vehicle.',
        icon: 'tabler:activity-heartbeat',
      },
      {
        title: 'Step 3: Clear Communication',
        description: 'We provide you with a detailed report and a transparent quote. We won’t proceed with any work until you approve it.',
        icon: 'tabler:message-circle-2',
      },
      {
        title: 'Step 4: Quality Repair',
        description: 'Our team performs the necessary repairs using high-quality parts and gets your vehicle back to you as soon as possible.',
        icon: 'tabler:tool',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1525909002-1b05e0c869d8?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=870&q=80',
      alt: 'A technician working on a car',
    }}
  />

  <!-- CallToAction Widget *********** -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Book an Appointment',
        href: 'https://my-booking-app-ecru.vercel.app/', // IMPORTANT: Update this link
        icon: 'tabler:calendar-event'
      },
    ]}
    title="Ready to Schedule Your Service?"
    subtitle="Don't wait for a small issue to become a big problem. Book your appointment today and experience the Akiya Power Tech difference."
  />
</Layout>