---
import Layout from '~/layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import Button from '~/components/ui/Button.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

// Using a relevant image for the custom header
import pageHeaderImage from '~/assets/images/About-page.jpg'; 

const metadata = {
  title: 'Why Choose Us | Akiya Power Tech',
  description: 'Discover why Akiya Power Tech is the leading choice for EV service and training in Addis Ababa. We offer certified technicians, advanced tools, and transparent pricing.'
};
---

<Layout metadata={metadata}>
  <!-- 
    CUSTOM HERO SECTION:
    - This is the new hero, styled exactly like the one on the about.astro page.
    - It is shorter, has a static background image, and is fully responsive.
  -->
  <section class="relative text-white">
    <div class="relative h-[50vh] min-h-[400px] overflow-hidden flex flex-col justify-center items-center text-center px-4">
      
      <!-- Background Image Layer -->
      <div class="absolute inset-0 z-0">
        <Image
          src={pageHeaderImage}
          alt="The Akiya Power Tech team working collaboratively"
          class="w-full h-full object-cover"
          format="webp"
          quality={80}
          loading="eager"
        />
        <!-- Dark Overlay -->
        <div class="absolute inset-0 bg-black/50"></div>
      </div>

      <!-- Content Layer -->
      <div class="relative z-10">
        <h1 class="text-4xl md:text-5xl font-bold leading-tight">
          Why Choose <span class="text-yellow-400">Akiya Power Tech?</span>
        </h1>
        <p class="hidden md:block mt-4 text-lg text-gray-200 max-w-3xl">
          We are more than just a service center; we are Ethiopia's hub for electric vehicle excellence.
        </p>
      </div>
    </div>
  </section>
  
  <!-- 
    MAIN CONTENT SECTION:
    - Your original Features2 component is preserved here.
    - It clearly lists your key advantages in an easy-to-scan format.
  -->
  <section class="bg-white dark:bg-slate-900 py-16 sm:py-20">
    <Features2
      title="Our Commitment to Excellence"
      subtitle="We are dedicated to providing the highest standard of service and expertise in the rapidly evolving world of electric vehicles."
      columns={3}
      items={[
        {
          title: 'Certified & Trained Technicians',
          description: 'Our technicians are not just mechanics; they are certified specialists trained in-house on the latest EV technology and safety protocols.',
          icon: 'tabler:certificate',
        },
        {
          title: 'Advanced Diagnostic Tools',
          description: 'We invest in state-of-the-art, manufacturer-approved equipment to accurately diagnose and resolve any issue with your EV.',
          icon: 'tabler:activity-heartbeat',
        },
        {
          title: 'Transparent Pricing & Communication',
          description: 'Receive clear, detailed estimates before any work begins. We believe in honest communication and no surprises.',
          icon: 'tabler:message-circle-2',
        },
        {
          title: 'Genuine & High-Quality Parts',
          description: 'We use only OEM or equivalent high-quality parts to ensure the integrity, safety, and longevity of your vehicle.',
          icon: 'tabler:settings-bolt',
        },
        {
          title: 'Customer-Centric Service',
          description: 'Your satisfaction is our priority. We provide a clean, professional environment and keep you informed every step of the way.',
          icon: 'tabler:users',
        },
        {
          title: 'Pioneering EV Education',
          description: 'Our connection to our training center means our service team is always learning, ensuring we are prepared for the future of EV tech.',
          icon: 'tabler:school',
        },
      ]}
    />
  </section>

  <!-- Final Call to Action -->
  <CallToAction
    actions={[
      { 
        variant: 'primary', 
        text: 'Book an Appointment', 
        href: 'https://my-booking-app-ecru.vercel.app/',
        icon: 'tabler:calendar-event',
        'data-confirm-external': true,
      },
    ]}
    title="Experience the Akiya Power Tech Difference"
    subtitle="Trust your electric vehicle to the experts. Schedule your service today and drive with confidence."
  />
</Layout>