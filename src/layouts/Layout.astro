---
import '~/assets/styles/tailwind.css';

import { I18N } from 'astrowind:config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';
import ConfirmationModal from '~/components/ui/confirmation.astro';

// Comment the line below to disable View Transitions
import { ClientRouter } from 'astro:transitions';

import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
}

const { metadata = {} } = Astro.props;
const { language, textDirection } = I18N;
---

<!doctype html>
<html lang={language} dir={textDirection} class="2xl:text-[20px]">
  <head>
    <CommonMeta />
    <Favicons />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <SiteVerification />
    <Analytics />

    <!-- Comment the line below to disable View Transitions -->
    <ClientRouter fallback="swap" />
  </head>

  <body class="antialiased text-default bg-page tracking-tight">
    <slot />

    <BasicScripts />
    <ConfirmationModal />

    {/* ======================================================================= */}
    {/* CONSOLIDATED SITE-WIDE SCRIPTS & STYLES */}
    {/* ======================================================================= */}
    <style is:global>
      @keyframes highlight-fade {
        0% {
          background-color: rgba(208, 222, 48, 0.25);
          box-shadow: 0 0 24px rgba(59, 130, 246, 0.3);
        }
        100% {
          background-color: transparent;
          box-shadow: 0 0 0 transparent;
        }
      }

      .highlight-momentary {
        animation: highlight-fade 5s ease-out forwards;
        border-radius: 8px; /* Optional: rounds the corners */
      }
    </style>

    <script is:inline>
      // This is our main function that runs all initialization scripts
      function initializePageScripts() {
        console.log('Astro event fired. Initializing page scripts...');
        setupExternalLinkConfirmations();
        setupAnchorHighlighting();
      }

      // --- Feature 1: Confirmation Modal ---
      function setupExternalLinkConfirmations() {
        const linksToConfirm = document.querySelectorAll('a[data-confirm-external]');
        linksToConfirm.forEach((link) => {
          // Check if a listener is already attached to avoid duplicates
          if (link.dataset.listenerAttached === 'true') {
            return;
          }
          link.dataset.listenerAttached = 'true'; // Mark it immediately

          link.addEventListener('click', (event) => {
            event.preventDefault();

            // All the modal logic is self-contained in this handler
            const modalBackdrop = document.getElementById('confirmation-modal-backdrop');
            const modalDialog = document.getElementById('confirmation-modal-dialog');
            const modalMessage = document.getElementById('confirmation-modal-message');
            const confirmBtn = document.getElementById('confirmation-modal-confirm-btn');
            const cancelBtn = document.getElementById('confirmation-modal-cancel-btn');
            const destination = link.getAttribute('href');
            const message = link.dataset.confirmMessage || 'You are being directed to an external page. Proceed?';

            // Ensure we found all the modal parts
            if (!modalBackdrop || !modalDialog || !modalMessage || !confirmBtn || !cancelBtn) {
              console.error('Confirmation modal elements not found in the DOM.');
              // Fallback: just navigate if the modal is broken
              window.open(destination, '_blank', 'noopener,noreferrer');
              return;
            }

            modalMessage.textContent = message;
            modalBackdrop.classList.remove('hidden');
            modalBackdrop.classList.add('flex');
            setTimeout(() => {
              modalBackdrop.classList.remove('opacity-0');
              modalDialog.classList.remove('scale-95');
            }, 10); // Short delay for transition

            // Use a one-time "once" listener for cleaner event handling
            confirmBtn.addEventListener('click', function onConfirm() {
              hideModal();
              window.open(destination, '_blank', 'noopener,noreferrer');
            }, { once: true });

            cancelBtn.addEventListener('click', function onCancel() {
              hideModal();
              console.log('Navigation cancelled by user.');
            }, { once: true });

            function hideModal() {
                modalBackdrop.classList.add('opacity-0');
                modalDialog.classList.add('scale-95');
                setTimeout(() => {
                    modalBackdrop.classList.add('hidden');
                    modalBackdrop.classList.remove('flex');
                }, 300); // Match transition duration
            }
          });
        });
      }

      // --- Feature 2: Anchor Link Highlighting ---
      function setupAnchorHighlighting() {
        const anchorLinks = document.querySelectorAll('a[href^="/#"]');
        anchorLinks.forEach((link) => {
          if (link.dataset.highlightListener === 'true') {
            return;
          }
          link.dataset.highlightListener = 'true';

          link.addEventListener('click', (event) => {
            const href = link.getAttribute('href');
            const targetId = href.split('#')[1];
            if (!targetId) return;

            const targetElement = document.getElementById(targetId);
            if (targetElement) {
              targetElement.classList.add('highlight-momentary');
              setTimeout(() => {
                targetElement.classList.remove('highlight-momentary');
              }, 2500); // Animation duration is 5s, but we can remove the class earlier
            }
          });
        });
      }

      // --- Attach Event Listeners ---
      // Run scripts when the page is first loaded
      document.addEventListener('DOMContentLoaded', initializePageScripts);
      // Run scripts again after every page transition
      document.addEventListener('astro:after-swap', initializePageScripts);
    </script>
  </body>
</html>