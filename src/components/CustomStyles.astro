---
import '@fontsource-variable/inter';
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    /* 🌿 Primary: Green */
    --aw-color-primary: rgb(34 197 94); /* Tailwind emerald-500 */
    
    /* 🌞 Secondary: Yellow */
    --aw-color-secondary: rgb(234 179 8); /* Tailwind yellow-500 */
    
    /* 🌊 Accent: Blue */
    --aw-color-accent: rgb(59 130 246); /* Tailwind blue-500 */

    /* 🖤 Text & Background (Light Mode) */
    --aw-color-text-heading: rgb(0 0 0);
    --aw-color-text-default: rgb(31 41 55); /* Tailwind gray-800 */
    --aw-color-text-muted: rgb(31 41 55 / 66%);
    --aw-color-bg-page: rgb(255 255 255);

    ::selection {
      background-color: rgb(234 179 8); /* yellow highlight */
      color: rgb(0 0 0);
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    /* 🌿 Primary: Green */
    --aw-color-primary: rgb(34 197 94);
    
    /* 🌞 Secondary: Yellow */
    --aw-color-secondary: rgb(234 179 8);
    
    /* 🌊 Accent: Blue */
    --aw-color-accent: rgb(59 130 246);

    /* 🌒 Text & Background (Dark Mode) */
    --aw-color-text-heading: rgb(240 253 244); /* Tailwind emerald-50 */
    --aw-color-text-default: rgb(226 232 240); /* Tailwind slate-200 */
    --aw-color-text-muted: rgb(226 232 240 / 66%);
    --aw-color-bg-page: rgb(2 6 23); /* Tailwind slate-950 */

    ::selection {
      background-color: rgb(34 197 94); /* green highlight */
      color: snow;
    }
  }
</style>
