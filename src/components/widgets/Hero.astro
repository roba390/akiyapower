---
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),
  image = await Astro.slots.render('image'),
  id,
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<section class="relative not-prose" {...id ? { id } : {}}>
  <!-- Background Image Container -->
  <div class="relative h-screen overflow-hidden">
    {image && (
      typeof image === 'string' ? (
        <Fragment set:html={image} />
      ) : (
        <Image
          class="w-full h-full object-cover"
          width={1920}
          height={1080}
          {...image}
        />
      )
    )}

    <!-- Dark Overlay for better text readability -->
    <div class="absolute inset-0 bg-black bg-opacity-60"></div>

    <!-- Content aligned to the left -->
    <div class="absolute inset-0 flex items-center">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <div class="max-w-2xl text-left">
          {tagline && (
            <p class="text-sm text-blue-300 font-semibold uppercase mb-2" set:html={tagline} />
          )}
          {title && (
            <h1 class="text-4xl md:text-5xl font-bold text-white mb-4" set:html={title} />
          )}
          {subtitle && (
            <p class="text-lg text-gray-200 mb-8" set:html={subtitle} />
          )}
          {actions && (
            <div class="flex flex-col sm:flex-row justify-start gap-4">
              {Array.isArray(actions) ? (
                actions.map((action) => (
                  <Button {...(action || {})} class="w-full sm:w-auto" />
                ))
              ) : (
                <Fragment set:html={actions} />
              )}
            </div>
          )}
          {content && <Fragment set:html={content} />}
        </div>
      </div>
    </div>
  </div>
</section>