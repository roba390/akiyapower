---
import { Image } from 'astro:assets';
import Button from '~/components/ui/Button.astro';

export type VideoSource = {
  src: string;
  type: 'video/mp4' | 'video/webm';
};

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  actions = await Astro.slots.render('actions'),
  id,
  image,
  video,
  poster,
} = Astro.props;
---

<section class="relative not-prose" {...id ? { id } : {}}>
  <div class="relative h-screen overflow-hidden">
    {video ? (
  <video
    class="absolute inset-0 w-full h-full object-cover z-10"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster={typeof poster.src === 'string' ? poster.src : poster.src.src}
  >
    {Array.isArray(video) && video.map(source => (
      <source src={source.src} type={source.type} />
    ))}
    Your browser does not support the video tag.
  </video>
    ) : (
      image && (
        <Image
          // 👇 ADDED: z-10 here as well for consistency
          class="w-full h-full object-cover z-10"
          width={1920}
          height={1080}
          loading="eager"
          {...image}
        />
      )
    )}

    <!-- Dark Overlay for better text readability -->
    {/* 👇 ADDED: z-20 to place it above the video/image */}
    <div class="absolute inset-0 bg-black bg-opacity-25 z-20"></div>

    <!-- Content aligned to the left -->
    {/* 👇 ADDED: z-30 to ensure it's on top of everything */}
    <div class="absolute inset-0 flex items-center z-30">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <div class="max-w-2xl text-left">
          {tagline && (
            <p class="text-sm text-blue-300 font-semibold uppercase mb-2" set:html={tagline} />
          )}
          {title && (
            <h1 class="text-4xl md:text-5xl font-bold text-white mb-4" set:html={title} />
          )}
          {subtitle && <Fragment set:html={subtitle} />}
          {actions && (
            <div class="flex flex-col sm:flex-row justify-start gap-4">
              {Array.isArray(actions) ? (
                actions.map((action) => (
                  <Button {...(action || {})} class="w-full sm:w-auto" />
                ))
              ) : (
                <Fragment set:html={actions} />
              )}
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</section>