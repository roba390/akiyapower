---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';
import { getHomePermalink, trimSlash } from '~/utils/permalinks';

// ===================================================================================
// THE DEFINITIVE FIX:
// 1. We DELETE the old, locally-defined 'Link' and 'MenuLink' interfaces.
// 2. We IMPORT the correct, central HeaderData and Link types from `~/types.ts`.
// ===================================================================================
import type { HeaderData, Link } from '~/types';

// This Props interface now correctly extends the central HeaderData type.
// This makes it aware of all the properties in your navigation.js file.
export interface Props extends HeaderData {
  id?: string;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

// Astro.props is now correctly typed according to our central blueprint.
const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = true,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
---

<header class:list={['fixed top-0 z-40 w-full transition-colors duration-300 ease-in-out']} id={id}>
  <!-- Background Div -->
  <div id="header-background" class="absolute inset-0 bg-black/20 transition-all duration-300 ease-in-out"></div>

  <!-- Content Div -->
  <div
    id="header-content"
    class:list={[
      'relative text-white px-3 md:px-6 mx-auto w-full pt-4 transition-colors duration-300 ease-in-out',
      {
        'md:flex md:justify-between': position !== 'center',
        'md:grid md:grid-cols-3 md:items-center': position === 'center',
        'max-w-7xl': !isFullWidth,
      },
    ]}
  >
    <div class:list={[{ 'mr-auto rtl:mr-0 rtl:ml-auto': position === 'right' }, 'flex justify-between']}>
      <a class="flex items-center" href={getHomePermalink()}><Logo /></a>
      <div class="flex items-center md:hidden"><ToggleMenu /></div>
    </div>

    <nav
      class="items-center w-full md:w-auto hidden md:flex md:mx-5 overflow-y-auto overflow-x-hidden md:overflow-y-visible md:overflow-x-auto md:justify-self-center"
      aria-label="Main navigation"
    >
      <ul
        class="flex flex-col md:flex-row md:self-center w-full md:w-auto text-xl md:text-[0.9375rem] tracking-[0.01rem] font-medium md:justify-center"
      >
        {
          links.map((link: Link) => (
            <li class={link.links?.length ? 'dropdown' : ''}>
              {link.links?.length ? (
                <>
                  <button
                    type="button"
                    class="hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap"
                  >
                    {link.text}
                    <Icon name="tabler:chevron-down" class="w-3.5 h-3.5 ml-0.5 rtl:ml-0 rtl:mr-0.5 hidden md:inline" />
                  </button>
                  <ul class="dropdown-menu md:backdrop-blur-md dark:md:bg-dark rounded md:absolute pl-4 md:pl-0 md:hidden font-medium md:bg-white/90 md:min-w-[200px] drop-shadow-xl">
                    {link.links.map((subLink: Link) => (
                      <li>
                        <a
                          class:list={[
                            'first:rounded-t last:rounded-b md:hover:bg-gray-100 py-2 px-5 block whitespace-no-wrap',
                            'dark:md:hover:bg-slate-700', 'text-slate-900 dark:text-slate-200',
                            'hover:text-primary dark:hover:text-white',
                            { 'aw-link-active': subLink.href === currentPath },
                          ]}
                          {...{ ...subLink, text: undefined, links: undefined }}
                        >
                          {subLink.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a
                  class:list={[
                    'hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap',
                    { 'aw-link-active': link.href === currentPath },
                  ]}
                  href={link.href}
                  {...{ ...link, text: undefined, links: undefined }}
                >
                  {link.text}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div
      class:list={[
        { 'ml-auto rtl:ml-0 rtl:mr-auto': position === 'left' },
        'hidden md:self-center md:flex items-center md:mb-0 fixed w-full md:w-auto md:static justify-end left-0 rtl:left-auto rtl:right-0 bottom-0 p-3 md:p-0 md:justify-self-end',
      ]}
    >
      <div class="items-center flex justify-between w-full md:w-auto">
        <div class="flex">{showToggleTheme && <ToggleTheme iconClass="w-6 h-6 md:w-5 md:h-5 md:inline-block" />}</div>
        {actions?.length ? (
          <span class="ml-4 rtl:ml-0 rtl:mr-4">
            {actions.map((btnProps: Link) => (
              <Button {...btnProps} class="ml-2 py-2.5 px-5.5 md:px-6 font-semibold shadow-none text-sm w-auto" />
            ))}
          </span>
        ) : (
          ''
        )}
      </div>
    </div>
  </div>
</header>

<style is:global>
  #header.scrolled #header-background {
    background-color: rgba(255, 255, 255, 0.98);
    backdrop-filter: none;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
  }
  #header.scrolled #header-content {
    color: #111827 !important;
  }
  .dark #header.scrolled #header-background {
    background-color: rgba(15, 23, 42, 0.98) !important;
  }
  .dark #header.scrolled #header-content {
    color: #ffffff !important;
  }
</style>

<script is:inline>
  function setupHeaderScrollListener() {
    const header = document.getElementById('header');
    if (!header) return;
    const scrollOffset = 10;
    const handleScroll = () => {
      if (window.scrollY > scrollOffset) {
        header.classList.add('scrolled');
      } else {
        header.classList.remove('scrolled');
      }
    };
    window.addEventListener('scroll', handleScroll);
    handleScroll();
  }
  document.addEventListener('astro:page-load', setupHeaderScrollListener);
</script>