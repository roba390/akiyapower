---
// src/components/ui/ConfirmationModal.astro
---
<div 
  id="confirmation-modal-backdrop" 
  class="fixed inset-0 bg-black bg-opacity-60 items-center justify-center z-[999] p-4 hidden opacity-0 transition-opacity duration-300"
>
  <div id="confirmation-modal-dialog" class="bg-white dark:bg-slate-800 rounded-lg shadow-xl w-full max-w-md p-6 transform scale-95 transition-transform duration-300">
    <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">
      Confirm Navigation
    </h3>
    
    <p id="confirmation-modal-message" class="text-slate-600 dark:text-slate-300 mb-6">
      <!-- The message will be injected here by JavaScript -->
    </p>

    <div class="flex justify-end gap-4">
      <button id="confirmation-modal-cancel-btn" class="btn bg-gray-200 hover:bg-gray-300 text-slate-800 dark:bg-slate-700 dark:hover:bg-slate-600 dark:text-white">
        Cancel
      </button>
      <button id="confirmation-modal-confirm-btn" class="btn btn-primary">
        Proceed
      </button>
    </div>
  </div>
</div>